{
  // ---------------------------------------------------------
  // Disable Microsoft C++ IntelliSense (clangd only)
  // ---------------------------------------------------------
  "C_Cpp.intelliSenseEngine": "Disabled",
  "C_Cpp.autocomplete": "Disabled",
  "C_Cpp.errorSquiggles": "Disabled",

  // ---------------------------------------------------------
  // clangd (language server)
  // ---------------------------------------------------------
  "clangd.path": "/home/stu5/s0/acp7795/LLVM-21.1.7-Linux-X64/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=build",
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed"
  ],

  // ---------------------------------------------------------
  // Formatting (LLVM clang-format)
  // ---------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.defaultFormatter": "xaver.clang-format",
  "clang-format.executable":
    "/home/stu5/s0/acp7795/LLVM-21.1.7-Linux-X64/bin/clang-format",

  // ---------------------------------------------------------
  // File associations
  // ---------------------------------------------------------
  "files.associations": {
    "*.tpp": "cpp",
    "*.hpp": "cpp",
    "*.ipp": "cpp"
  },

  // ---------------------------------------------------------
  // Noise reduction
  // ---------------------------------------------------------
  "files.exclude": {
    "**/.git": true,
    "**/.cache": true
  }
}
